package main

import (
	"context"
	"errors"
	"flag"
	"fmt"
	"os"
	"os/signal"
	"strings"
	"syscall"
	"time"
)

type options struct {
{{- if .Envs}}
	env      string
{{- end}}
	targets  []string
	parallel int
	timeout  time.Duration
	anim     string
	logPath  string
}

var errBadArgs = errors.New("bad arguments")

func main() {
	started := time.Now()
	code := exitStatus(run())

	appendRunlog(started, code)
	os.Exit(code)
}

func exitStatus(err error) int {
	if err == nil {
		return 0
	}
	if errors.Is(err, flag.ErrHelp) {
		return 2
	}

	fmt.Fprintf(os.Stderr, "error: %v\n", err)
	if errors.Is(err, errBadArgs) {
		return 2
	}
	return 1
}

func run() error {
	opts, err := parseFlags()
	if err != nil {
		return err
	}

	s, err := NewScreen(Options{Mode: opts.anim, LogPath: opts.logPath, Tool: "{{.ID}}"})
	if err != nil {
		return fmt.Errorf("%w: %v", errBadArgs, err)
	}
	defer s.Close()

	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	ctx, cancel := context.WithTimeout(ctx, opts.timeout)
	defer cancel()

	s.Note("  %s{{.ID}}%s{{if .Envs}}  env=%s{{end}}  %d targets, %d at a time", s.C.Bold, s.C.Reset{{if .Envs}}, opts.env{{end}}, len(opts.targets), opts.parallel)

	tasks := s.Fan(ctx, "targets", opts.targets, opts.parallel, inspect)

	failed := 0
	for _, task := range tasks {
		if task.Err != nil {
			failed++
			continue
		}
		fmt.Printf("%s\t%s\n", task.Name, task.Detail)
	}

	if failed > 0 {
		return fmt.Errorf("%d of %d targets failed", failed, len(tasks))
	}
	return nil
}

func defaultTargets() []string {
	return []string{"target-1", "target-2", "target-3"}
}

func inspect(ctx context.Context, target string, report func(detail string)) (string, error) {
	report("connecting")
	if err := ctx.Err(); err != nil {
		return "", err
	}
	return "", errors.New("inspect is not written yet")
}

func parseFlags() (options, error) {
	var opts options
	var targets string
{{if .Envs}}
	flag.StringVar(&opts.env, "env", "{{.DefaultEnv}}", "environment: {{.EnvList}}")
{{- end}}
	flag.StringVar(&targets, "targets", strings.Join(defaultTargets(), ","), "comma-separated targets")
	flag.IntVar(&opts.parallel, "parallel", 8, "how many targets run at once")
	flag.DurationVar(&opts.timeout, "timeout", 2*time.Minute, "overall timeout")
	flag.StringVar(&opts.anim, "anim", "auto", "animation: auto (by TTY), always or never")
	flag.StringVar(&opts.logPath, "log", "auto", "audit log path, \"auto\" for the state dir, \"-\" disables it")

	flag.CommandLine.Init(os.Args[0], flag.ContinueOnError)
	if err := flag.CommandLine.Parse(os.Args[1:]); err != nil {
		if errors.Is(err, flag.ErrHelp) {
			return opts, err
		}
		return opts, fmt.Errorf("%w: %v", errBadArgs, err)
	}
	if flag.NArg() > 0 {
		return opts, fmt.Errorf("%w: unexpected arguments %q", errBadArgs, flag.Args())
	}

	for target := range strings.SplitSeq(targets, ",") {
		if trimmed := strings.TrimSpace(target); trimmed != "" {
			opts.targets = append(opts.targets, trimmed)
		}
	}
	if len(opts.targets) == 0 {
		return opts, fmt.Errorf("%w: -targets is empty", errBadArgs)
	}
{{if .Envs}}
	switch opts.env {
	case {{.EnvCases}}:
	default:
		return opts, fmt.Errorf("%w: unknown -env=%q, expected {{.EnvList}}", errBadArgs, opts.env)
	}
{{- end}}
	if opts.parallel <= 0 {
		return opts, fmt.Errorf("%w: -parallel must be positive, got %d", errBadArgs, opts.parallel)
	}
	if opts.timeout <= 0 {
		return opts, fmt.Errorf("%w: -timeout must be positive, got %s", errBadArgs, opts.timeout)
	}

	return opts, nil
}
